# conexao com o banco: copie este arquivo para application.properties e preencha
# o application.properties real nao e versionado (tem a senha)
spring.datasource.url=jdbc:postgresql://localhost:5432/NOME_DO_BANCO
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false

# log: console e arquivo, no mesmo formato (hora, nivel, classe : mensagem)
spring.main.banner-mode=off
logging.file.name=logs/app.log
logging.pattern.console=%d{HH:mm:ss} %-5level %logger{0} : %msg%n
logging.pattern.file=%d{HH:mm:ss} %-5level %logger{0} : %msg%n
logging.level.root=WARN
logging.level.br.com.ifba=DEBUG
